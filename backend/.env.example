# CloudGuard AI Environment Configuration

# GCP Vertex AI Agent Builder Settings
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
VERTEX_AGENT_ID=your-vertex-agent-id

# Gemini Vision Settings (Task 3 direct API)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL_NAME=gemini-3.5-flash

# Google Workspace Sheets Settings (Task 2)
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_OAUTH_CREDENTIALS_PATH=credentials.json
GOOGLE_OAUTH_TOKEN_PATH=token.json

# Service Runtime
ENVIRONMENT=development
